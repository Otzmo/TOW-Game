{
  "rules": {
    "rooms": {
      "$room": {
        "players": {
          ".read": "auth != null",
          "$slot": {
            ".write": "auth != null && !data.exists() && newData.val() === auth.uid",
            ".validate": "($slot === 'p1' || $slot === 'p2') && newData.isString()"
          }
        },
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && (root.child('rooms').child($room).child('players/p1').val() === auth.uid || root.child('rooms').child($room).child('players/p2').val() === auth.uid)"
        },
        "units": {
          ".read": "auth != null",
          ".write": "auth != null && (root.child('rooms').child($room).child('players/p1').val() === auth.uid || root.child('rooms').child($room).child('players/p2').val() === auth.uid)"
        },
        "objects": {
          ".read": "auth != null",
          ".write": "auth != null && (root.child('rooms').child($room).child('players/p1').val() === auth.uid || root.child('rooms').child($room).child('players/p2').val() === auth.uid)"
        },
        "flow": {
          ".read": "auth != null",
          ".write": "auth != null && (root.child('rooms').child($room).child('players/p1').val() === auth.uid || root.child('rooms').child($room).child('players/p2').val() === auth.uid)"
        },
        "log": {
          ".read": "auth != null",
          ".write": "auth != null && (root.child('rooms').child($room).child('players/p1').val() === auth.uid || root.child('rooms').child($room).child('players/p2').val() === auth.uid)"
        }
      }
    }
  }
}
